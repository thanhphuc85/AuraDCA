# Circle API key from https://console.circle.com/api-keys
CIRCLE_API_KEY=your-circle-api-key

# Entity secret registered for Developer-Controlled Wallets in the Circle Console.
# NEVER commit a real value.
CIRCLE_ENTITY_SECRET=your-circle-entity-secret

# Developer-Controlled Wallet id on Arc Testnet, created via:
#   npm run create-wallet
WALLET_ID=your-wallet-id

# Circle Swap Kit key from Circle Developer Console
KIT_KEY=your-circle-swap-kit-key

# Anthropic API key used for the daily DCA decision call AND the dashboard chat
# assistant (api/chat.ts on Vercel). Set this in Vercel env vars to enable chat.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Guardrails (all amounts are decimal USDC strings)
MAX_DAILY_USDC=1.00
MIN_USDC_RESERVE=0.50
MIN_SWAP_USDC=0.10
CAMPAIGN_TOTAL_BUDGET_USDC=
CAMPAIGN_DURATION_DAYS=

# Set to "true" to skip the real swap call and just log what would happen
DRY_RUN=true

# --- On-chain audit anchor (contracts/AuraAttestation.sol) ---
# After each run the agent records keccak256(data/ledger.json) in this contract,
# so the committed audit trail is verifiable on-chain. Both OFF by default:
# nothing happens until you deploy the contract and flip ATTESTATION_ENABLED.
# Deploy + verify steps: contracts/README.md.
ATTESTATION_CONTRACT=
ATTESTATION_ENABLED=false

# Non-custodial allowance model: agent pulls USDC from each user's wallet via
# transferFrom (user approves an allowance on the dashboard) instead of a pooled
# deposit. Off by default. Turn on only after users have approved allowances.
ALLOWANCE_MODE=false

# --- Dip-buying ladder (Phase 1) ---
# Deeper drawdown tiers buy more. Thresholds are drawdown-from-high fractions,
# multipliers scale the base amount. All optional (defaults shown).
DCA_BASE_AMOUNT=1.00
DCA_DIP_MILD_THRESHOLD=0.05
DCA_DIP_MODERATE_THRESHOLD=0.10
DCA_DIP_STRONG_THRESHOLD=0.20
DCA_DIP_DEEP_THRESHOLD=0.30
DCA_DIP_MILD_MULTIPLIER=1.2
DCA_DIP_MODERATE_MULTIPLIER=1.5
DCA_DIP_STRONG_MULTIPLIER=2.0
DCA_DIP_DEEP_MULTIPLIER=2.5
# When recent volatility is high, widen every tier threshold by this factor.
DCA_LADDER_VOL_WIDEN=1.3
# The deepest tier never allocates more than this fraction of available balance.
DCA_LADDER_MAX_BALANCE_FRACTION=0.5

# --- Withdrawal API (api/withdraw.ts, deployed on Vercel) ---
# GitHub token with Contents:read/write on this repo, used to commit ledger
# balance updates after a withdrawal. See DEPLOY.md.
GH_PAT=your-github-pat
# The withdrawal API reads CIRCLE_WALLET_ID, falling back to WALLET_ID above.
CIRCLE_WALLET_ID=your-wallet-id

# --- Welcome email (api/send-welcome.ts) ---
# API key from https://resend.com/api-keys — used to send a real welcome email
# when a user signs up with their email on the dashboard.
RESEND_API_KEY=your-resend-api-key
# Optional sender. Defaults to Resend's shared "onboarding@resend.dev", which
# only delivers to your own Resend account email until you verify a domain.
# After verifying a domain in Resend, set this to e.g. "Aura DCA <hi@yourdomain.com>".
RESEND_FROM=

# --- Telegram alerts (server-side, always-on) ---
# Push a rich alert on every cron run — a buy landing, an error, the smart
# multiplier used — even when no dashboard tab is open. This is separate from the
# dashboard's browser notifier. Create a bot with @BotFather (token) and get your
# chat id from @userinfobot. For the cron: TELEGRAM_BOT_TOKEN as a GitHub Actions
# SECRET; TELEGRAM_CHAT_ID and TELEGRAM_NOTIFY_ON as (non-sensitive) VARIABLES.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# What to alert on: "smart" (default: successes + errors, skips routine no-op
# runs), "all" (every run), or "errors" (only failures).
TELEGRAM_NOTIFY_ON=smart

# --- x402 pay-per-call (api/x402-brief.ts, src/x402/*) ---
# An HTTP-402 metered endpoint: the agent pays USDC (a signed EIP-3009
# transferWithAuthorization) to unlock a "premium market brief". Honest slice —
# the payment is signed and cryptographically VERIFIED but NOT settled on-chain
# (mirrors the paper-fill pattern). Nothing here is required for DCA to run.
# Wallet that receives the metered payment. Defaults to the agent's own address.
X402_PAY_TO=
# Price per call, in whole USDC (default 0.001).
X402_BRIEF_PRICE_USDC=0.001
# EIP-712 domain of Arc Testnet USDC the authorization is signed under. Defaults
# to name "USDC" / version "2"; override only if Arc's USDC advertises different
# values (so a future on-chain settle stays valid).
X402_USDC_NAME=USDC
X402_USDC_VERSION=2
# Only for `npm run x402-demo`: point the demo at a deployed endpoint to run the
# full 402→pay→200 loop over HTTP. Unset → the demo runs the handshake offline.
# Also used by the gated run-loop integration (below) to pay over HTTP.
X402_BRIEF_URL=
# --- Gated run-loop integration (src/x402/agent.ts) ---
# When "true", each DCA run pays for its market-brief input via x402 (best-effort,
# off the money path — never blocks or alters the DCA). Inert unless BOTH this and
# X402_PAYER_PRIVATE_KEY are set. In CI: X402_ENABLED as a VARIABLE,
# X402_PAYER_PRIVATE_KEY as a SECRET.
X402_ENABLED=false
# A dedicated TESTNET private key the agent signs the x402 payment with. Signing
# with the agent's Circle Developer-Controlled Wallet is the documented next step;
# never reuse a key that holds anything of value.
X402_PAYER_PRIVATE_KEY=
# --- Full on-chain settlement via Circle Gateway ("Nanopayments") ---
# When "true", the brief payment is SETTLED on-chain (not just verified): the
# agent pays the deployed X402_BRIEF_URL through Circle Gateway's batched x402
# rail and records the real settlement tx hash (shown in the dashboard history).
# The endpoint (api/x402-brief.ts) also switches to the Gateway protocol when
# this is on. Requires @circle-fin/x402-batching + @x402/core + @x402/evm (in
# package.json) and the prerequisites below. Off by default (verify-only).
X402_SETTLE_ENABLED=false
# The x402 payer (X402_PAYER_PRIVATE_KEY) must hold a Circle Gateway USDC deposit
# — the pay itself is gasless. Set this to auto-top-up the Gateway balance to at
# least N USDC before paying (needs USDC + native gas in the payer wallet the
# first time). Leave blank to skip auto-deposit and use an existing balance.
X402_DEPOSIT_USDC=
# Circle Gateway x402 facilitator (verify + settle). Defaults to the testnet
# endpoint; override only to point at a different Gateway facilitator.
X402_FACILITATOR_URL=https://gateway-api-testnet.circle.com

# --- Smart execution fee (x402 pay-per-execution, TESTNET DEMO) ---
# When ON, each smart-mode user whose LIVE buy actually executes is charged a flat
# USDC fee, deducted from their deposited balance and accrued to the treasury —
# a demo of metered x402 fees. Off the swap path, paper fills are never charged,
# and the fee is clamped to the user's balance (never negative). Gated + inert by
# default. This is NOT a real on-chain user payment; it is accounted in the ledger.
X402_SMART_FEE_ENABLED=false
# Flat fee per executed smart buy, in USDC. Falls back to 0.01 when unset/invalid.
X402_SMART_FEE_USDC=0.01
# OPTIONAL on-chain settlement of the collected fee via Circle Gateway
# (Nanopayments). When BOTH X402_SETTLE_ENABLED=true AND this URL are set, each run
# settles its total smart fee as one on-chain payment (agent → X402_PAY_TO) with a
# real tx hash. Unset = the fee stays ledger-accounted only (the default). Point it
# at the deployed endpoint, e.g. https://aura-dca.xyz/api/x402-smart-fee
X402_SMART_FEE_URL=
# Hard ceiling (USDC) on a single settled fee, guarding the payer's Gateway
# balance against a malformed amount. Defaults to 5.
X402_SMART_FEE_MAX_USDC=5
